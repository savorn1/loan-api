# Copy this file to .env on the server and fill in real values.
# .env is gitignored — never commit the real one.

# Domain Caddy will request a TLS cert for (must already point at this server's IP).
# For local/no-DNS testing, use ":80" to serve plain HTTP on port 80 instead.
DOMAIN=example.com

# Postgres password used by every service's datasource.
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=changeme

# Redis password (customer-service rate limiting).
# Generate with: openssl rand -base64 24
REDIS_PASSWORD=changeme

# JWT signing secret shared by api-gateway and auth-service.
# Must be different from the dev secret committed in application.yml/.properties.
# Generate with: openssl rand -base64 48
JWT_SECRET=changeme

# MinIO / S3-compatible object storage, used by common-storage (wired into
# auth-service, customer-service, loan-service and loan-product-service). For
# local MinIO, run:
#   docker run -p 9000:9000 -p 9001:9001 minio/minio server /data --console-address ":9001"
# then create the bucket named below (via the MinIO console or `mc mb`).
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_REGION=us-east-1
S3_BUCKET=visa-documents
# S3_ENDPOINT is what each service uses to actually talk to MinIO — in
# docker-compose.yml this gets overridden per-service to the in-network
# hostname (http://minio:9000), which a browser can't resolve. S3_PUBLIC_ENDPOINT
# is the browser-reachable base URL baked into the URLs handed back to clients
# (avatar images, document links, etc.) — a real public domain in production,
# localhost here for local dev. Falls back to S3_ENDPOINT if left unset.
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
